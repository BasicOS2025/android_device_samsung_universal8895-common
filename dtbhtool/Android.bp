// Legacy Exynos 8895 DTBH tools, with unique names alongside hardware/samsung.
cc_library_host_static {
    name: "libdtbimg_8895",
    srcs: ["dtbimg.c"],
    static_libs: ["libfdt"],
    local_include_dirs: ["libdtbimg", "."],
    export_include_dirs: ["libdtbimg"],
}

cc_binary_host {
    name: "dtbhtoolExynos8895",
    srcs: ["mkdtbimg.c"],
    static_libs: ["libdtbimg_8895"],
}

cc_binary_host {
    name: "mkdtbhbootimg8895",
    srcs: ["mkbootimg.c"],
    static_libs: ["libdtbimg_8895"],
    shared_libs: ["libcrypto"],
    cflags: ["-Wno-deprecated-declarations"],
}
